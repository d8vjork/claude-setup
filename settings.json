{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "laravel-boost@claude-plugins-official": true,
    "expo-app-design@expo-plugins": true,
    "upgrading-expo@expo-plugins": true,
    "expo-deployment@expo-plugins": true,
    "fullstack-dev-skills@fullstack-dev-skills": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "orchestration@claude-setup": true
  },
  "extraKnownMarketplaces": {
    "claude-setup": {
      "source": {
        "source": "github",
        "repo": "d8vjork/claude-setup"
      }
    },
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    },
    "fullstack-dev-skills": {
      "source": {
        "source": "github",
        "repo": "jeffallan/claude-skills"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "awaySummaryEnabled": false,
  "autoCompactEnabled": true,
  "model": "sonnet"
}
